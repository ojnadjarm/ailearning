{
  "name": "ailearning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "How machines learn, drawn as machines you can tune: narrated cutaway plates.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/content-check.mjs && node tools/hygiene.mjs",
    "build": "vite build",
    "postbuild": "node tools/base-check.mjs && node tools/link-check.mjs && node tools/bundle-check.mjs && node tools/hygiene.mjs --dist",
    "preview": "node tests/lib/pages-sim.mjs",
    "typecheck": "tsc --noEmit",
    "hygiene": "node tools/hygiene.mjs",
    "kit:verify": "node tools/kit-verify.mjs",
    "kit:sync": "tools/sync-kit.sh",
    "test": "node --import ./tests/lib/register.mjs --test tests/unit/*.test.mjs",
    "e2e": "node tests/run-e2e.mjs",
    "test:changed": "node tools/test-changed.mjs",
    "ci": "npm run typecheck && npm run kit:verify && npm test && npm run build && npm run e2e",
    "check-links": "tools/check-links.sh",
    "cue-check": "node --import ./tests/lib/register.mjs tools/cue-check.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "playwright-core": "^1.63.0-alpha-2026-08-31",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.0"
  }
}
